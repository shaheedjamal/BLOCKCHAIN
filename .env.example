# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# Server Port (default 3000)
PORT=3000

# Authentication JWT Secret (change to a secure random string in production)
JWT_SECRET="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET"

# SQLite Database Path (academic prototype local persistent RDBMS)
DB_PATH="./data/land_records.db"

# Optional PostgreSQL / PostGIS connection string for production deployments
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/land_records"

# Private Document Storage Directory
STORAGE_DIR="./storage/documents"

# Backup Archive Directory
BACKUP_DIR="./backups"

# Hyperledger Fabric Mode: "simulated" (local permissioned simulation) or "gateway"
FABRIC_NETWORK_MODE="simulated"
FABRIC_CHANNEL_NAME="landrecords-channel"
FABRIC_CHAINCODE_NAME="land_record_chaincode"

# GEMINI_API_KEY: Required only if Gemini AI features are explicitly enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

